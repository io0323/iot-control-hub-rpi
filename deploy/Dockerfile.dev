# 開発用コンテナ（詳細設計書 第9章）。Debian bookworm（GCC 12）＋ scripts/deps-apt.txt ＋ uv ＋ iotspec。
# CI も同じイメージで動かす。
FROM debian:bookworm

ARG IOTSPEC_REF=v0.2.2
ENV DEBIAN_FRONTEND=noninteractive \
    GW_IN_CONTAINER=1 \
    UV_TOOL_DIR=/opt/uv/tools \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python

COPY scripts/deps-apt.txt /tmp/deps-apt.txt
RUN apt-get update \
    && grep -v '^#' /tmp/deps-apt.txt | xargs apt-get install -y --no-install-recommends \
    && ln -sf /usr/bin/clang-format-15 /usr/local/bin/clang-format \
    && ln -sf /usr/bin/clang-tidy-15 /usr/local/bin/clang-tidy \
    && ln -sf /usr/bin/run-clang-tidy-15 /usr/local/bin/run-clang-tidy \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/
# 結合テスト（tests/integration）は iotspec と同じ環境の pytest で動かす
RUN uv tool install --python 3.12 --with pytest --with pytest-asyncio \
      "iotspec @ git+https://github.com/io0323/iot-common-spec@${IOTSPEC_REF}" \
    && chmod -R a+rX /opt/uv \
    && iotspec-contract --role gw-01 --list >/dev/null
ENV IOTSPEC_REF=${IOTSPEC_REF}

WORKDIR /work
